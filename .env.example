# PostgreSQL + pgvector connection string.
# Local Homebrew default (current OS user, no password) is used if unset.
DATABASE_URL=postgresql://localhost:5432/embedding_lab

# ── Generation (Phase 4) — DeepSeek, the single generation model ───────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Generation temperature (held constant across all pipelines).
GENERATION_TEMPERATURE=0.0

# Optional pricing for cost observability (USD per 1M tokens). Leave unset to
# skip cost estimation — we never hard-code provider pricing.
# DEEPSEEK_INPUT_COST_PER_M=
# DEEPSEEK_OUTPUT_COST_PER_M=
