# ── Database ────────────────────────────────────────────────────────────────
# Connection string that fully determines the database (Railway injects this).
DATABASE_URL=

# ── Generation (DeepSeek) ───────────────────────────────────────────────────
DEEPSEEK_API_KEY=
GENERATION_MODEL=deepseek-chat
# (DEEPSEEK_MODEL is a deprecated alias for GENERATION_MODEL)

# ── Retrieval ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=bge
TOP_K=2

# ── Observability / security ────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=*
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW=60

# ── Model cache ─────────────────────────────────────────────────────────────
HF_HOME=/app/.hf_cache
